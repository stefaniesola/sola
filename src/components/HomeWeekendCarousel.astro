---
import { weekends2027, fullDate, priceLabel, priceTerms, priceSummary } from '../data/weekends2027';
import landscape from '../assets/images/GeoPark Famenne Ardenne - landschap Hoge Venen (6).jpg';
import sport from '../assets/images/home-carousel/simon.jpg';
import verdieping from '../assets/images/home-carousel/sarah.jpg';
import learning from '../assets/images/home-carousel/leefstijlweekend.jpg';
import nature from '../assets/images/home-carousel/ademhaling.jpg';
import jorien from '../assets/images/jorien-raeymaekers.jpg';
import { getImage } from 'astro:assets';
const photos = [landscape, ...await Promise.all([sport, verdieping, learning, nature].map(src => getImage({ src, width: 1400, format: 'webp', quality: 85 })))];
const photoPositions = ['50% 50%', '50% 65%', '50% 24%', '50% 50%', '50% 48%'];
const photoAlts = ['', 'Bewegingsoefeningen buiten met Simon', 'Drie vrouwen samen buiten tijdens een SOLA-weekend', 'Het landschap van de Hoge Venen', 'Een begeleide groepssessie buiten'];
---
<section class="bg-white" aria-roledescription="carrousel" aria-label="SOLA-weekends 2027" data-weekend-carousel>
  <div class="max-w-6xl mx-auto px-6 py-14 lg:py-20">
    <header class="carousel-heading">
      <h2 class="text-3xl font-semibold text-base-900" data-carousel-heading>Volgend weekend</h2>
      <div class="carousel-controls" hidden>
        <span class="carousel-count" aria-live="polite" aria-atomic="true" data-carousel-count>1 / {weekends2027.length}</span>
        <button type="button" aria-label="Vorig weekend" data-carousel-prev>←</button>
        <button type="button" aria-label="Volgend weekend" data-carousel-next>→</button>
      </div>
    </header>
    <div class="weekend-deck">
    {weekends2027.map((weekend, index) => (
      <article hidden={index !== 0} data-carousel-slide aria-roledescription="dia" aria-label={`${index + 1} van ${weekends2027.length}: ${weekend.title}`} class="weekend-slide overflow-hidden rounded-3xl border border-base-200 bg-base-25 shadow-sm">
        <a href={weekend.detailHref ?? weekend.href} class="weekend-photo relative overflow-hidden bg-base-200" aria-label={weekend.detailHref ? `${weekend.detailLabel}: ${weekend.title}` : weekend.cta}>
          <img src={photos[index].src} width={photos[index].width} height={photos[index].height} style={{ objectPosition: photoPositions[index] }} alt={index === 0 ? `${weekend.title} in ${weekend.location}` : photoAlts[index]} loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover" />
          <span class="absolute left-5 top-5 rounded-full bg-base-25 px-4 py-2 text-xs font-semibold uppercase tracking-wide text-base-900 shadow-sm">{index === 0 ? 'Volgend weekend' : weekend.label}</span>
        </a>
        <div class="flex flex-col justify-center p-7 sm:p-9 lg:p-12">
          <div class="flex flex-wrap items-center gap-3 text-xs uppercase tracking-wide text-base-500">
            {weekend.location && <span class="rounded-full border border-base-200 bg-base-100 px-3 py-1">{weekend.location}</span>}
            <span>{fullDate(weekend)}</span>
          </div>
          <h3 class="mt-5 text-3xl font-semibold text-base-900 lg:text-4xl">{weekend.title}</h3>
          <p class="mt-2 text-lg font-semibold text-accent-700">{weekend.subtitle}</p>
          {index !== 0 && <p class="mt-3 font-semibold text-base-700">{weekend.expert}</p>}
          <div class="mt-4 flex items-start gap-4">
            {index === 0 && <img src={jorien.src} width={jorien.width} height={jorien.height} alt="Jorien Raeymaekers" loading="lazy" class="h-16 w-16 shrink-0 rounded-full border-2 border-white object-cover shadow-sm sm:h-20 sm:w-20" />}
            <p class="text-base leading-relaxed text-base-700">{weekend.copy}</p>
          </div>
          <div class="mt-7 flex flex-wrap items-center gap-3 border-t border-base-200 pt-5">
            {weekend.earlyPrice && <p class="w-full text-sm font-semibold text-accent-700">{weekend.deadline ? `${priceLabel(weekend)} · ${priceTerms(weekend)}` : priceSummary(weekend)}</p>}
            {weekend.note && <p class="w-full text-sm text-base-700">{weekend.note}</p>}
            <a href={weekend.href} target={weekend.href.startsWith('https:') ? '_blank' : undefined} rel={weekend.href.startsWith('https:') ? 'noopener noreferrer' : undefined} class="inline-flex items-center rounded-full bg-accent-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-accent-700">{weekend.cta}</a>
            {weekend.detailHref && <a href={weekend.detailHref} class="inline-flex items-center rounded-full border border-base-300 px-5 py-3 text-sm font-semibold text-base-900 transition hover:border-base-500">{weekend.detailLabel}</a>}
          </div>
        </div>
      </article>
    ))}
    </div>
    <a href="/reizen#agenda-2027" class="mt-6 flex flex-wrap items-center justify-between gap-4 rounded-3xl border border-base-200 bg-base-100 px-6 py-5 text-base-900 transition hover:bg-base-200">
      <span><span class="block text-xs uppercase tracking-[0.18em] text-accent-700">Meer SOLA in 2027</span><span class="mt-1 block text-xl font-semibold">Beweging. Verdieping. Leefstijl. Ademhaling.</span></span>
      <span class="text-sm font-semibold">Bekijk de SOLA-agenda 2027 <span aria-hidden="true">↗</span></span>
    </a>
  </div>
</section>
<style>
  .carousel-heading { display:flex; align-items:center; justify-content:space-between; gap:1rem; margin-bottom:1.5rem; }
  .carousel-controls { display:flex; align-items:center; gap:.5rem; flex-shrink:0; }
  .carousel-controls[hidden] { display:none; }
  .weekend-deck { display:grid; }
  .weekend-slide[hidden] { display:grid !important; visibility:hidden; pointer-events:none; }
  .carousel-count { font-size:.8rem; color:#746859; margin-right:.25rem; }
  .carousel-controls button { width:44px; height:44px; border:1px solid #b8afa0; border-radius:50%; color:#ad552e; font-size:1.5rem; }
  .carousel-controls button:hover { background:#f0e8db; }
  .carousel-controls button:focus-visible { outline:2px solid #ad552e; outline-offset:3px; }
  .weekend-slide { display:grid; grid-area:1 / 1; grid-template-rows:280px 1fr; min-width:0; }
  .weekend-photo { min-height:280px; }
  @media(min-width:1024px) { .weekend-slide { grid-template-columns:1.15fr 1fr; grid-template-rows:1fr; } .weekend-photo { min-height:430px; } }
  @media(max-width:480px) { .carousel-heading h2 { font-size:1.5rem; } .carousel-count { font-size:.7rem; } }
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-weekend-carousel]').forEach(carousel => {
    const slides = [...carousel.querySelectorAll<HTMLElement>('[data-carousel-slide]')];
    const controls = carousel.querySelector<HTMLElement>('.carousel-controls')!;
    const count = carousel.querySelector<HTMLElement>('[data-carousel-count]')!;
    const heading = carousel.querySelector<HTMLElement>('[data-carousel-heading]')!;
    let current = 0;
    const show = (step: number) => {
      current = (current + step + slides.length) % slides.length;
      slides.forEach((slide, index) => { slide.hidden = index !== current; });
      count.textContent = `${current + 1} / ${slides.length}`;
      heading.textContent = current === 0 ? 'Volgend weekend' : 'Meer SOLA in 2027';
    };
    controls.hidden = false;
    carousel.querySelector('[data-carousel-prev]')!.addEventListener('click', () => show(-1));
    carousel.querySelector('[data-carousel-next]')!.addEventListener('click', () => show(1));
    controls.addEventListener('keydown', event => {
      if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
        event.preventDefault(); show(event.key === 'ArrowLeft' ? -1 : 1);
      }
    });
  });
</script>
