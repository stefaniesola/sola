---
interface Photo { src: string; full: string; alt: string; width: number; height: number; }
interface Props { photos: Photo[]; }
const { photos } = Astro.props;
---
<div class:list={["weekend-photos", { "weekend-photos-four": photos.length > 2 }]}>
  {photos.map((photo) => (
    <a href={photo.full} data-weekend-photo aria-label={`Foto vergroten: ${photo.alt}`}>
      <img src={photo.src} alt={photo.alt} width={photo.width} height={photo.height} loading="lazy" decoding="async" />
      <span aria-hidden="true" class="photo-expand">↗</span>
    </a>
  ))}
</div>
<style>
  .weekend-photos { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; margin-top: 1.5rem; }
  .weekend-photos a { display: block; position: relative; overflow: hidden; cursor: zoom-in; }
  .weekend-photos img { display: block; width: 100%; height: 220px; object-fit: contain; background: var(--color-base-100); }
  .photo-expand { position: absolute; right: .5rem; bottom: .5rem; width: 32px; height: 32px; display: grid; place-items: center; border-radius: 50%; background: rgb(255 255 255 / .9); color: var(--color-base-900); }
  .weekend-photos a:focus-visible { outline: 3px solid var(--color-accent-600); outline-offset: 4px; }
  @media (min-width: 768px) { .weekend-photos-four { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  @media (max-width: 479px) { .weekend-photos img { height: 180px; } }
</style>
