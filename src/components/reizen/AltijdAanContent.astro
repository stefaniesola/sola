---
import { jorien2027 as edition, fullDate, priceLabel, priceTerms, dayLabel } from "../../data/weekends2027";
import { Image, getImage } from "astro:assets";
import WeekendPhotoGallery from "./WeekendPhotoGallery.astro";
import avondmaalImage from "../../assets/images/altijd-aan/avondmaal.jpg";
import bewegingImage from "../../assets/images/altijd-aan/beweging.jpg";
import hotTubImage from "../../assets/images/altijd-aan/hot-tub.jpg";
import jorienImage from "../../assets/images/altijd-aan/jorien-portret.jpeg";
import samenBuitenImage from "../../assets/images/altijd-aan/samen-buiten.jpg";

const bookingHref = edition.href;
const existingPhotoFull = await Promise.all(
  [samenBuitenImage, hotTubImage, avondmaalImage, bewegingImage].map((src) =>
    getImage({ src, width: 1600, format: "webp", quality: 80 }),
  ),
);
const weekendPhotos = [
  {
    "src": "/images/altijd-aan/gallery/wandelen-thumb.webp",
    "full": "/images/altijd-aan/gallery/wandelen-full.webp",
    "alt": "Wandelen in de natuur tijdens een SOLA-weekend",
    "width": 360,
    "height": 480
  },
  {
    "src": "/images/altijd-aan/gallery/yoga-thumb.webp",
    "full": "/images/altijd-aan/gallery/yoga-full.webp",
    "alt": "Samen yoga beoefenen in de tuin tijdens een SOLA-weekend",
    "width": 360,
    "height": 480
  },
  {
    "src": "/images/altijd-aan/gallery/trailrun-thumb.webp",
    "full": "/images/altijd-aan/gallery/trailrun-full.webp",
    "alt": "Trailrun tijdens een SOLA-weekend",
    "width": 360,
    "height": 480
  },
  {
    "src": "/images/altijd-aan/gallery/hoge-venen-thumb.webp",
    "full": "/images/altijd-aan/gallery/hoge-venen-full.webp",
    "alt": "Landschap van de Hoge Venen",
    "width": 480,
    "height": 360
  },
  {
    "src": "/images/altijd-aan/gallery/woonkamer-thumb.webp",
    "full": "/images/altijd-aan/gallery/woonkamer-full.webp",
    "alt": "Woonkamer van het verblijf",
    "width": 480,
    "height": 360
  },
  {
    "src": "/images/altijd-aan/gallery/slaapkamer-thumb.webp",
    "full": "/images/altijd-aan/gallery/slaapkamer-full.webp",
    "alt": "Slaapkamer van het verblijf",
    "width": 360,
    "height": 480
  },
  {
    "src": "/images/altijd-aan/gallery/samen-aan-tafel-thumb.webp",
    "full": "/images/altijd-aan/gallery/samen-aan-tafel-full.webp",
    "alt": "Samen aan tafel tijdens een SOLA-weekend",
    "width": 360,
    "height": 480
  },
  {
    "src": "/images/altijd-aan/gallery/verse-maaltijd-thumb.webp",
    "full": "/images/altijd-aan/gallery/verse-maaltijd-full.webp",
    "alt": "Verse groenten en een maaltijd tijdens een SOLA-weekend",
    "width": 360,
    "height": 480
  }
];

const forYou = [
  "je wordt moe wakker, ook wanneer je voldoende hebt geslapen",
  "je hoofd blijft doordraaien terwijl je lichaam moe is",
  "je vindt het moeilijk om van actie naar rust te schakelen",
  "je raakt snel overprikkeld",
  "spanning blijft langer hangen",
  "je herstel duurt langer dan vroeger",
  "je wil beter begrijpen wat je lichaam nodig heeft",
];

const focus = [
  "hoe het autonome zenuwstelsel schakelt tussen actie en herstel",
  "waar overbelasting vandaan kan komen",
  "hoe je signalen van stress en energieverlies herkent",
  "wat over- en onderprikkeling met je doen",
  "waarom slapen niet altijd hetzelfde is als herstellen",
  "welke invloed licht, koffie, gsm-gebruik, beweging en dagritme hebben",
  "wat jou energie geeft en wat energie vraagt",
  "hoe je een persoonlijk herstelprotocol opstelt",
];

const included = [
  "driedaags weekend met twee overnachtingen",
  "inhoudelijke begeleiding door Jorien Raeymaekers",
  "alle sessies en oefeningen",
  "yoga en HIIT onder begeleiding van de SOLA-crew",
  "wandeling of trailrun onder begeleiding van de SOLA-crew",
  "verblijf op locatie",
  "alle maaltijden van vrijdagavond tot en met zondagmiddag",
  "koffie, thee, water, aperitief en tussendoortjes",
  "een SOLA-shirt",
];

const faqs = [
  [
    "Voor wie is dit weekend bedoeld?",
    "Voor wie merkt dat ontspannen of voldoende slapen niet altijd leidt tot echt herstel. Misschien sta je vaak aan, blijf je piekeren, raak je snel overprikkeld of word je moe wakker. Tijdens het weekend leer je beter begrijpen waar dat vandaan komt en wat jou kan helpen.",
  ],
  [
    "Welke inzichten komen aan bod tijdens het weekend?",
    "Jorien legt uit hoe je zenuwstelsel reageert op stress en wat dat betekent voor herstel. Daarbij komen onder meer de polyvagaaltheorie en je stressvenster aan bod: kaders om te kijken naar spanning, veiligheid en hoeveel prikkels je op een bepaald moment aankunt. Je koppelt die uitleg aan je eigen lichaamssignalen en dagelijkse gewoontes.",
  ],
  [
    "Wat mag ik van het weekend verwachten?",
    "Inhoudelijke sessies met Jorien, afgewisseld met praktische oefeningen, beweging en tijd in de natuur. Je leert je eigen stress- en energiepatronen herkennen en onderzoekt wat jou helpt om van actie naar herstel te schakelen.",
  ],
  [
    "Wat is een persoonlijk herstelplan?",
    "Een concreet plan dat je tijdens het weekend met begeleiding van Jorien uitwerkt. Je vertaalt jouw inzichten naar kleine, haalbare aanpassingen in je dagritme, slaap, beweging en omgang met prikkels, zodat je er thuis mee verder kunt.",
  ],
  [
    "Waarom combineren we inhoudelijke sessies met beweging?",
    "Beweging is onderdeel van het onderzoek naar je stress- en herstelpatroon. Je vergelijkt wat verschillende vormen van inspanning doen met je spanning, ademhaling en energieniveau, en leert letten op het verschil tussen activering en herstel.",
  ],
  [
    "Moet ik sportief zijn?",
    "Nee. De bewegingssessies zijn toegankelijk en worden aangepast aan de groep. Het doel is niet om te presteren, maar om te ervaren wat verschillende vormen van beweging met je lichaam en energieniveau doen. De beweging vóór het ontbijt is volledig optioneel.",
  ],
  [
    "Moet ik persoonlijke ervaringen delen?",
    "Nee. Er is ruimte om ervaringen uit te wisselen, maar je kiest altijd zelf wat je wel en niet wilt delen. Je kunt de meeste oefeningen ook individueel maken.",
  ],
  [
    "Moet ik iets voorbereiden?",
    "Dat hoeft niet. Wie wil, kan gedurende de twee weken vóór het weekend een eenvoudig energiedagboek bijhouden. Je noteert enkele minuten per dag welke activiteiten energie geven of vragen, wanneer je veel of weinig energie hebt en welke signalen je opmerkt. Tijdens het weekend kun je deze informatie gebruiken om je eigen stress- en herstelpatroon beter in kaart te brengen.",
  ],
  [
    "Hoe groot is de groep?",
    "We werken met minimaal 6 en maximaal 12 deelnemers.",
  ],
  [
    "Hoe zijn de kamers geregeld?",
    "Je slaapt standaard met twee personen op een kamer. De kamerindeling gebeurt per hetzelfde geslacht. Schrijf je je samen met je partner in, dan kunnen jullie een kamer delen. Elke kamer heeft een eigen badkamer. Een eenpersoonskamer is mogelijk tegen een supplement en afhankelijk van de beschikbaarheid.",
  ],
  [
    "Kan er rekening worden gehouden met allergieën of blessures?",
    "Ja. Bij je inschrijving kun je allergieën, voedingsvoorkeuren, blessures en andere aandachtspunten doorgeven. We bekijken vooraf hoe we daar rekening mee kunnen houden.",
  ],
];
---

<section class="max-w-6xl mx-auto px-6 py-12">
  <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
    {[
      ["Wanneer", fullDate(edition), "Aankomst vrijdag vanaf 18.00 uur"],
      ["Waar", "Sourbrodt", "Hoge Venen, Ardennen"],
      ["Prijs", priceLabel(edition), priceTerms(edition)],
      ["Groep", "Minimaal 6", "Maximaal 12 deelnemers"],
    ].map(([label, value, detail]) => (
      <article class="border border-base-200 bg-base-25 p-5 shadow-sm">
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-base-500">{label}</p>
        <p class="mt-2 text-lg font-semibold text-base-900">{value}</p>
        <p class="mt-1 text-sm text-base-600">{detail}</p>
      </article>
    ))}
  </div>
</section>

<nav aria-label="Inhoud van deze pagina" class="border-y border-base-200 bg-white">
  <div class="mx-auto max-w-6xl px-6 py-4">
    <p class="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-base-500">Op deze pagina</p>
    <div class="weekend-section-links">
      <a class="weekend-section-link" href="#voor-wie">Voor wie</a>
      <a class="weekend-section-link" href="#inbegrepen">Inbegrepen</a>
      <a class="weekend-section-link" href="#begeleiding">Begeleiding</a>
      <a class="weekend-section-link" href="#programma">Programma</a>
      <a class="weekend-section-link" href="#verblijf">Verblijf & maaltijden</a>
      <a class="weekend-section-link" href="#boeken">Prijs & boeken</a>
      <a class="weekend-section-link" href="#faq">FAQ</a>
    </div>
  </div>
</nav>

<section id="voor-wie" class="scroll-mt-28 border-y border-base-200 bg-base-50/80">
  <div class="max-w-6xl mx-auto px-6 py-14 grid gap-10 lg:grid-cols-2">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.22em] text-accent-700">Voor wie?</p>
      <h2 class="mt-3 text-3xl font-semibold text-base-900">Je neemt rust, maar je lichaam blijft alert.</h2>
      <p class="mt-4 leading-relaxed text-base-700">Dit weekend is bedoeld voor wie merkt dat ontspannen of voldoende slapen niet altijd tot echt herstel leidt.</p>
      <ul class="mt-6 space-y-3 text-base-700">
        {forYou.map((item) => <li class="flex gap-3"><span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-accent-500"></span><span>{item}</span></li>)}
      </ul>
    </div>
    <div class="border border-base-200 bg-white p-6 shadow-sm sm:p-8">
      <p class="text-xs font-semibold uppercase tracking-[0.22em] text-accent-700">Focus</p>
      <h2 class="mt-3 text-3xl font-semibold text-base-900">Wat je leert</h2>
      <ul class="mt-6 space-y-3 text-base-700">
        {focus.map((item) => <li class="flex gap-3"><span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-accent-500"></span><span>{item}</span></li>)}
      </ul>
    </div>
  </div>
</section>

<section id="inbegrepen" class="scroll-mt-28 max-w-6xl mx-auto px-6 py-14">
  <div class="grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.22em] text-accent-700">Alles voor het weekend</p>
      <h2 class="mt-3 text-3xl font-semibold text-base-900">Wat is inbegrepen?</h2>
      <ul class="mt-6 grid gap-3 sm:grid-cols-2 text-base-700">
        {included.map((item) => <li class="flex gap-3"><span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-accent-500"></span><span>{item}</span></li>)}
      </ul>
      <p class="mt-6 text-base-700"><strong>Niet inbegrepen:</strong> transport van en naar Sourbrodt.</p>
      <p class="mt-2 text-base-700">Iedereen komt op eigen vervoer. Kort voor het weekend bekijken we samen de mogelijkheden om te carpoolen, zodat iedereen ter plaatse geraakt.</p>
    </div>
    <a href={existingPhotoFull[0].src} data-weekend-photo class="weekend-existing-photo" aria-label="Foto vergroten">
    <Image src={samenBuitenImage} alt="Deelnemers samen buiten tijdens een SOLA-weekend" class="h-full min-h-80 w-full object-cover" widths={[480, 720, 960]} sizes="(min-width: 1024px) 40vw, 100vw" />
    </a>
  </div>
</section>

<section id="begeleiding" class="scroll-mt-28 bg-base-900 text-white">
  <div class="max-w-6xl mx-auto px-6 py-14">
    <div class="grid overflow-hidden border border-white/20 bg-white/10 lg:grid-cols-[minmax(280px,0.42fr)_minmax(0,1fr)]">
      <a href="https://ikbenjorien.be/" target="_blank" rel="noreferrer">
        <Image src={jorienImage} alt="Jorien Raeymaekers" class="h-96 w-full object-cover lg:h-full" widths={[420, 640, 840]} sizes="(min-width: 1024px) 38vw, 100vw" />
      </a>
      <div class="p-6 sm:p-8 lg:p-10">
        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-white/60">Expertise & coördinatie</p>
        <h2 class="mt-3 text-3xl font-semibold">Jorien Raeymaekers</h2>
        <div class="mt-5 space-y-4 leading-relaxed text-white/80">
          <p>Jorien is klinisch psycholoog en systemisch werker, met vervolgopleidingen in familieopstellingen en EMDR. In haar praktijk begeleidt ze particulieren, ondernemers en leidinggevenden. Ze kijkt naar klachten én de gewoontes, omgeving en patronen die ermee samenhangen.</p>
          <p>Tijdens het weekend vertaalt ze inzichten over het autonome zenuwstelsel, stress, slaap, prikkelverwerking en herstel naar herkenbare situaties en praktische oefeningen. Haar aanpak is warm, helder en direct.</p>
        </div>
        <a href="https://ikbenjorien.be/" target="_blank" rel="noopener noreferrer" class="mt-5 inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-white underline decoration-white/50 underline-offset-4 hover:decoration-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white">Meer over Jorien en haar praktijk <span aria-hidden="true">↗</span></a>
        <h3 class="mt-6 text-xl font-semibold">SOLA-crew</h3>
        <p class="mt-3 leading-relaxed text-white/80">Justine Deleu verzorgt de maaltijden, Klaas Annys de wandeling en Stefanie Deleu de trailrun. De SOLA-crew begeleidt yoga en HIIT.</p>
      </div>
    </div>
  </div>
</section>

<section id="programma" class="scroll-mt-28 max-w-5xl mx-auto px-6 py-14">
  <p class="text-xs font-semibold uppercase tracking-[0.22em] text-accent-700">Van vrijdagavond tot zondagmiddag</p>
  <h2 class="mt-3 text-3xl font-semibold text-base-900">Programma</h2>
  <div class="mt-8 divide-y divide-base-200 border-y border-base-200">
    <details class="group py-6">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-2xl font-semibold text-base-900">
        <span>{dayLabel(edition.startDate!, 0)}</span><span class="text-accent-700 transition group-open:rotate-45">+</span>
      </summary>
      <div class="mt-6 space-y-5 text-base-700">
        <div><p class="font-semibold text-base-900">Vanaf 18.00 uur</p><p>Aankomst, kennismaking en inchecken<br />Aperitief, briefing en eerste inhoudelijke schets van het weekend</p></div>
        <div><p class="font-semibold text-base-900">19.30 uur</p><p>Avondmaal</p></div>
        <div><p class="font-semibold text-base-900">20.30 uur</p><p>Openingssessie</p></div>
        <div><p class="font-semibold text-base-900">Na de openingssessie</p><p>Hot tub, drankje en vrije tijd</p></div>
      </div>
    </details>
    <details class="group py-6" open>
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-2xl font-semibold text-base-900">
        <span>{dayLabel(edition.startDate!, 1)}</span><span class="text-accent-700 transition group-open:rotate-45">+</span>
      </summary>
      <div class="mt-6 space-y-5 text-base-700">
        <div><p class="font-semibold text-base-900">Vanaf 06.00 uur — vrijblijvend</p><p>Dauwwandeling voor wie wil</p></div>
        <div><p class="font-semibold text-base-900">07.30 uur</p><p>Actieve sessie met oefeningen</p></div>
        <div><p class="font-semibold text-base-900">08.15 uur</p><p>Ontbijt</p></div>
        <div><p class="font-semibold text-base-900">09.00 uur</p><p>Inhoudelijke sessie met Jorien — Waarom rust soms niets doet</p><p class="mt-2 text-sm">Hoe je zenuwstelsel reageert op stress en waarom je lichaam soms alert blijft terwijl je rust.</p></div>
        <div><p class="font-semibold text-base-900">10.30 uur</p><p>Pauze</p></div>
        <div><p class="font-semibold text-base-900">11.00 uur</p><p>Verdieping met Jorien — jouw stress- en energiepatroon</p><p class="mt-2 text-sm">Je onderzoekt wat energie vraagt en hoe je lichaam dat aangeeft.</p></div>
        <div><p class="font-semibold text-base-900">12.30 uur</p><p>Lunch</p></div>
        <div><p class="font-semibold text-base-900">14.30 uur</p><p>Wandeling van ongeveer 8 km of trailrun van ongeveer 12 km</p><p class="mt-2 text-sm">Je kiest zelf wat bij je niveau en goesting past.</p></div>
        <div><p class="font-semibold text-base-900">Vanaf 17.30 uur</p><p>Terugkomst, douche en vrije tijd</p></div>
        <div><p class="font-semibold text-base-900">19.00 uur</p><p>Avondmaal</p></div>
        <div><p class="font-semibold text-base-900">20.30 uur</p><p>Inhoudelijke sessie met Jorien — overdenken begrijpen en doorbreken</p></div>
        <div><p class="font-semibold text-base-900">Vanaf 21.30 uur</p><p>Hot tub, drankje en vrije tijd</p></div>
      </div>
    </details>
    <details class="group py-6">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-2xl font-semibold text-base-900">
        <span>{dayLabel(edition.startDate!, 2)}</span><span class="text-accent-700 transition group-open:rotate-45">+</span>
      </summary>
      <div class="mt-6 space-y-5 text-base-700">
        <div><p class="font-semibold text-base-900">07.30 uur</p><p>Actieve sessie: yoga of HIIT</p></div>
        <div><p class="font-semibold text-base-900">08.30 uur</p><p>Ontbijt</p></div>
        <div><p class="font-semibold text-base-900">09.30 uur</p><p>Inhoudelijke sessie met Jorien — Slaap en herstel</p><p class="mt-2 text-sm">Hoe je dagelijkse gewoontes je slaap en herstel beïnvloeden.</p></div>
        <div><p class="font-semibold text-base-900">11.00 uur</p><p>Pauze</p></div>
        <div><p class="font-semibold text-base-900">11.15 uur</p><p>Praktische sessie met Jorien — jouw persoonlijke herstelplan</p></div>
        <div><p class="font-semibold text-base-900">13.00 uur</p><p>Lunch</p></div>
        <div><p class="font-semibold text-base-900">14.00 uur</p><p>Afronding en vertrek</p></div>
      </div>
    </details>
  </div>
  <WeekendPhotoGallery photos={weekendPhotos.slice(0, 4)} />
</section>

<section id="verblijf" class="scroll-mt-28 border-y border-base-200 bg-base-50/80">
  <div class="max-w-6xl mx-auto px-6 py-14 grid gap-10 lg:grid-cols-2">
    <article class="weekend-stay-card">
      <a href={existingPhotoFull[1].src} data-weekend-photo class="weekend-existing-photo" aria-label="Foto vergroten">
      <Image src={hotTubImage} alt="Hot tub bij het verblijf in Sourbrodt" class="h-72 w-full object-cover" widths={[480, 720, 960]} sizes="(min-width: 1024px) 50vw, 100vw" />
      </a>
      <h2 class="mt-6 text-3xl font-semibold text-base-900">Verblijf</h2>
      <div class="mt-4 space-y-4 leading-relaxed text-base-700">
        <p>We verblijven in Sourbrodt, in de Hoge Venen, in een ruim en comfortabel groepshuis.</p>
        <p>Je slaapt standaard met twee personen op een kamer. De kamerindeling gebeurt per hetzelfde geslacht. Schrijf je je samen met je partner in, dan kunnen jullie een kamer delen.</p>
        <p>Elke kamer heeft een eigen badkamer. Een eenpersoonskamer is mogelijk tegen een supplement en afhankelijk van de beschikbaarheid.</p>
      </div>
      <WeekendPhotoGallery photos={weekendPhotos.slice(4, 6)} />
    </article>
    <article class="weekend-stay-card">
      <a href={existingPhotoFull[2].src} data-weekend-photo class="weekend-existing-photo" aria-label="Foto vergroten">
      <Image src={avondmaalImage} alt="Avondmaal tijdens een SOLA-weekend" class="h-72 w-full object-cover" widths={[480, 720, 960]} sizes="(min-width: 1024px) 50vw, 100vw" />
      </a>
      <h2 class="mt-6 text-3xl font-semibold text-base-900">Maaltijden</h2>
      <div class="mt-4 space-y-4 leading-relaxed text-base-700">
        <p>Alle maaltijden zijn inbegrepen, van het avondmaal op vrijdag tot en met de lunch op zondag.</p>
        <p>Justine zorgt voor gezonde, evenwichtige en vooral lekkere maaltijden, met aandacht voor energie. Een deel van de groenten komt uit eigen kweek.</p>
        <p>Allergieën en voedingsvoorkeuren kun je bij je inschrijving doorgeven.</p>
      </div>
      <WeekendPhotoGallery photos={weekendPhotos.slice(6, 8)} />
    </article>
  </div>
</section>

<section id="boeken" class="scroll-mt-28 max-w-6xl mx-auto px-6 py-14">
  <div class="grid overflow-hidden bg-accent-700 text-white lg:grid-cols-[1fr_0.75fr]">
    <div class="p-7 sm:p-10">
      <p class="text-xs font-semibold uppercase tracking-[0.22em] text-white/70">Vroegboekkorting</p>
      <h2 class="mt-3 text-4xl font-semibold">€70 korting</h2>
      <p class="mt-4 text-lg text-white/90">{priceLabel(edition)}. {priceTerms(edition)}</p>
      <p class="mt-2 text-white/80">Er zijn maximaal 12 plaatsen.</p>
      <a href={bookingHref} target="_blank" rel="noreferrer" class="mt-7 inline-flex rounded-full bg-white px-6 py-3 font-semibold text-accent-800 hover:bg-base-50">Boek je plek</a>
    </div>
    <a href={existingPhotoFull[3].src} data-weekend-photo class="weekend-existing-photo" aria-label="Foto vergroten">
