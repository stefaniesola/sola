</dialog>

<style>
  #verblijf .weekend-stay-card { display: flex; flex-direction: column; min-width: 0; }
  #verblijf .weekend-stay-card > div:first-of-type { flex: 1; }
  .weekend-existing-photo { border-radius: 1.25rem; overflow: hidden; }
  #programma > div { border: 0; display: grid; gap: 1rem; margin-bottom: 2rem; }
  #programma details { border: 1px solid var(--color-base-200); border-radius: 1.25rem; padding: 1.4rem; background: var(--color-base-25); }
  #programma details[open] { border-color: var(--color-accent-500); background: var(--color-base-50); }
  #programma summary { font-size: 1.35rem; }
  #programma summary > span:last-child { display: grid; place-items: center; width: 36px; height: 36px; flex-shrink: 0; border-radius: 50%; background: white; }
  #programma details > div > div { padding-left: 1rem; border-left: 2px solid var(--color-accent-500); }
  #programma details > div > div > p:first-child { color: var(--color-accent-700); font-size: .875rem; }
  #voor-wie > div > div:last-child, #boeken > div, #na-inschrijving > div > div:last-child { border-radius: 1.25rem; }
  #faq details { padding-left: .5rem; padding-right: .5rem; }
  #faq details[open] { background: var(--color-base-25); border-radius: .75rem; }
  @media (min-width: 640px) { #programma details > div > div { display: grid; grid-template-columns: 175px minmax(0, 1fr); gap: 0 1rem; } #programma details > div > div > p:first-child { grid-row: 1 / 4; } #programma details > div > div > p:not(:first-child) { grid-column: 2; } }
  .weekend-section-links { display: flex; flex-wrap: wrap; gap: .5rem; }
  .weekend-section-link { display: inline-flex; align-items: center; min-height: 44px; padding: .65rem 1rem; border: 1px solid var(--color-base-200); border-radius: 999px; font-size: .875rem; font-weight: 600; color: var(--color-base-700); }
  .weekend-section-link:hover { border-color: var(--color-accent-600); color: var(--color-accent-700); background: var(--color-base-50); }
  .weekend-section-link:focus-visible, .weekend-existing-photo:focus-visible { outline: 3px solid var(--color-accent-600); outline-offset: 4px; }
  .weekend-existing-photo { display: block; cursor: zoom-in; }
  #weekend-photo-viewer { margin: auto; max-width: min(94vw, 1200px); max-height: 92dvh; padding: 0; border: 0; background: var(--color-base-900); overflow: hidden; }
  #weekend-photo-viewer::backdrop { background: rgb(0 0 0 / .82); }
  #weekend-photo-viewer img { display: block; width: auto; height: auto; max-width: 94vw; max-height: 92dvh; object-fit: contain; }
  .weekend-photo-close { position: absolute; top: .5rem; right: .5rem; width: 44px; height: 44px; border-radius: 50%; background: white; color: var(--color-base-900); font-size: 2rem; line-height: 1; cursor: pointer; }
  .weekend-photo-close:focus-visible { outline: 3px solid var(--color-accent-600); outline-offset: 3px; }
</style>

<script>
  const viewer = document.querySelector<HTMLDialogElement>('#weekend-photo-viewer');
  const photo = viewer?.querySelector<HTMLImageElement>('img');
  const close = viewer?.querySelector<HTMLButtonElement>('.weekend-photo-close');
  if (viewer && photo && close) {
    document.querySelectorAll<HTMLAnchorElement>('a[data-weekend-photo]').forEach((link) => {
      link.addEventListener('click', (event) => {
        if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        photo.src = link.href;
        photo.alt = link.querySelector('img')?.alt ?? 'Foto van een SOLA-weekend';
        viewer.setAttribute('aria-label', photo.alt);
        viewer.showModal();
      });
    });
    close.addEventListener('click', () => viewer.close());
    viewer.addEventListener('click', (event) => {
      if (event.target !== viewer) return;
      const bounds = viewer.getBoundingClientRect();
      if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) viewer.close();
    });
  }
</script>