---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { journeys, uspTags, reizenPage } from "../../data/content";
import { getImage } from "astro:assets";
import bewustwordingImage from "../../assets/images/2631991747.jpg";
import terraImage from "../../assets/images/1513986998.jpg";
import altijdAanCardImage from "../../assets/images/GeoPark Famenne Ardenne - landschap Hoge Venen (6).jpg";

const weekends = journeys.filter((journey) => journey.type === "Weekend");
const trips = journeys.filter((journey) => journey.type === "Reis");
const linkClass = "text-white/90 underline-offset-4 hover:text-white";
const upcomingCopy =
  "Nieuwe reizen, weekenden en plekken zijn in voorbereiding. Blijf op de hoogte van wat eraan komt."
    .replace("reizen", `<a href="/reizen" class="${linkClass}">reizen</a>`)
    .replace("weekenden", `<a href="/weekenden" class="${linkClass}">weekenden</a>`);

// Process hero images for weekends
const weekendsWithImages = await Promise.all(
  weekends.map(async (weekend) => {
    let imageUrl =
      typeof weekend.heroImage === "string"
        ? weekend.heroImage
        : weekend.heroImage?.src;
    let heroImageData;
    if (weekend.heroImage) {
      if (typeof weekend.heroImage === "string") {
        // If it's a local image path, process it
        if (weekend.heroImage.startsWith("/src/assets/images/")) {
          if (weekend.slug === "bewustwording-connectie") {
            heroImageData = await getImage({
              src: bewustwordingImage,
              width: 1400,
              quality: 85,
            });
            imageUrl = heroImageData.src;
          }
        }
      } else {
        heroImageData = await getImage({
          src: weekend.heroImage,
          width: 1400,
          quality: 85,
        });
        imageUrl = heroImageData.src;
      }
    }
    return { ...weekend, heroImage: imageUrl, heroImageData };
  }),
);

// Process hero images for trips
const tripsWithImages = await Promise.all(
  trips.map(async (trip) => {
    let imageUrl =
      typeof trip.heroImage === "string" ? trip.heroImage : trip.heroImage?.src;
    let heroImageData;
    if (trip.heroImage) {
      // If it's a local image path, process it
      if (typeof trip.heroImage === "string") {
        if (trip.heroImage.startsWith("/src/assets/images/")) {
          if (trip.slug === "sola-terra-frankrijk") {
            heroImageData = await getImage({
              src: terraImage,
              width: 1400,
              quality: 85,
            });
            imageUrl = heroImageData.src;
          }
        }
      } else {
        heroImageData = await getImage({
          src: trip.heroImage,
          width: 1400,
          quality: 85,
        });
        imageUrl = heroImageData.src;
      }
    }
    return { ...trip, heroImage: imageUrl, heroImageData };
  })
);

const nextEdition = tripsWithImages.find((trip) => trip.slug === "altijd-aan");
const previousEditions = weekendsWithImages
  .filter((weekend) =>
    ["exercise-is-medicine", "bewustwording-connectie"].includes(weekend.slug),
  )
  .map((weekend) => ({
    ...weekend,
    dates:
      weekend.slug === "bewustwording-connectie"
        ? "31 juli – 2 augustus 2026"
        : weekend.dates,
  }));
---

<BaseLayout
  title={reizenPage.title}
  description={reizenPage.metaDescription}
>
  <section class="bg-base-50/80 border-b border-base-200">
    <div class="max-w-6xl mx-auto px-6 py-16 space-y-6">
      <p class="uppercase text-xs tracking-[0.25em] text-base-500">
        {reizenPage.label}
      </p>
      <h1 class="text-4xl font-semibold text-base-900">
        {reizenPage.heading}
      </h1>
      <p class="text-base-700 max-w-3xl">
        {reizenPage.description}
      </p>
      <div class="flex flex-wrap gap-2">
        {
          uspTags.map((tag) => (
            <span class="px-3 py-1 rounded-full bg-base-25 border border-base-200 text-sm text-base-700">
              {tag}
            </span>
          ))
        }
      </div>
    </div>
  </section>

  {nextEdition && (
    <section class="max-w-6xl mx-auto px-6 pt-14">
      <div class="mb-6">
        <h2 class="text-3xl font-semibold text-base-900">
          Volgende editie
        </h2>
      </div>
      <a
        href={`/reizen/${nextEdition.slug}`}
        class="group grid overflow-hidden rounded-3xl border border-base-200 bg-base-25 shadow-sm transition hover:shadow-lg lg:grid-cols-[1.15fr_1fr]"
      >
        <div class="relative min-h-[280px] overflow-hidden bg-base-200 lg:min-h-[430px]">
          <img
            class="absolute inset-0 h-full w-full object-cover transition duration-500 group-hover:scale-[1.02]"
            src={altijdAanCardImage.src}
            width={altijdAanCardImage.width}
            height={altijdAanCardImage.height}
            alt={`${nextEdition.name} in ${nextEdition.location}`}
            loading="eager"
            decoding="async"
          />
          <div class="absolute left-5 top-5 rounded-full bg-base-25 px-4 py-2 text-xs font-semibold uppercase tracking-wide text-base-900 shadow-sm">
            Volgende editie
          </div>
        </div>
        <div class="flex flex-col justify-center p-7 sm:p-9 lg:p-12">
          <div class="flex flex-wrap items-center gap-3 text-xs uppercase tracking-wide text-base-500">
            <span class="rounded-full border border-base-200 bg-base-100 px-3 py-1">
              {nextEdition.location}
            </span>
            <span>{nextEdition.dates}</span>
          </div>
          <h2 class="mt-5 text-3xl font-semibold text-base-900 lg:text-4xl">
            {nextEdition.name}
          </h2>
          <p class="mt-4 text-base leading-relaxed text-base-700">
            Samen met Jorien Raeymaekers onderzoek je hoe herstel fysiologisch werkt. Waarom blijft je systeem aan, ook wanneer je rust neemt? En hoe kan je je zenuwstelsel opnieuw leren schakelen via ademhaling, yoga, beweging en natuur?
          </p>
          <div class="mt-7 flex flex-wrap items-center justify-between gap-4 border-t border-base-200 pt-5 text-sm font-semibold">
            <span class="text-base-900">Prijs TBA</span>
            <span class="inline-flex items-center rounded-full bg-accent-600 px-5 py-3 text-white transition group-hover:bg-accent-700">
              {nextEdition.ctaLabel ?? "Bekijk details"}
            </span>
          </div>
        </div>
      </a>
    </section>
  )}

  <section class="max-w-6xl mx-auto px-6 py-14">
    <div class="mb-6">
      <h2 class="text-3xl font-semibold text-base-900">
        Eerdere SOLA-edities
      </h2>
    </div>
    <div class="grid gap-6 md:grid-cols-2">
    {
      previousEditions.map((weekend) => (
        <a
          href={`/weekenden/${weekend.slug}`}
          class="group flex flex-col overflow-hidden rounded-3xl border border-base-200 bg-base-25 shadow-sm transition hover:shadow-md"
        >
          <div class="relative aspect-[16/8] overflow-hidden bg-base-200">
            {weekend.heroImage && (
              <img
                class="absolute inset-0 h-full w-full object-cover"
                src={weekend.heroImage}
                width={weekend.heroImageData?.width ?? 1400}
                height={weekend.heroImageData?.height ?? 933}
                alt={`${weekend.name} in ${weekend.location}`}
                loading="lazy"
                decoding="async"
              />
            )}
            <div class="absolute left-4 top-4 rounded-full bg-base-25/95 px-3 py-1.5 text-xs font-semibold uppercase tracking-wide text-base-700 shadow-sm">
              Eerdere editie
            </div>
          </div>
          <div class="flex flex-1 flex-col space-y-3 p-6">
            <div class="flex flex-wrap items-center gap-3 text-xs uppercase tracking-wide text-base-500">
              <span class="rounded-full border border-base-200 bg-base-100 px-3 py-1">
                {weekend.location}
              </span>
              <span>{weekend.dates}</span>
            </div>
            <h2 class="text-xl font-semibold text-base-900">{weekend.name}</h2>
            <p class="text-base-700">{weekend.shortDescription}</p>
            <div class="mt-auto border-t border-base-200 pt-4 text-sm font-semibold">
              <span class="text-accent-700 group-hover:underline">
                Bekijk eerdere editie
              </span>
            </div>
          </div>
        </a>
      ))
    }
    </div>
  </section>

  <section class="bg-accent-600 text-white py-12">
    <div class="max-w-6xl mx-auto px-6">
      <div class="flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="flex-1">
          <h3 class="text-2xl font-semibold mb-2">Binnenkort beschikbaar</h3>
          <p class="text-white/80" set:html={upcomingCopy} />
        </div>
        <div class="flex flex-wrap gap-3">
          <a
            href="/newsletter"
            class="inline-flex items-center justify-center px-5 py-3 rounded-full border border-white/40 text-white font-semibold hover:border-white/60 hover:bg-white/10"
          >
            Blijf op de hoogte
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

