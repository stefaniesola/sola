---
import { getImage } from "astro:assets";
import AltijdAanContent from "../../components/reizen/AltijdAanContent.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { Journey } from "../../data/content";
import { journeys } from "../../data/content";
import terraImage from "../../assets/images/1513986998.jpg";
import { processMarkdown } from "../../utils/markdown";

export async function getStaticPaths() {
  return Promise.all(
    journeys.filter((journey) => journey.type === "Reis").map(async (trip) => {
      let imageUrl = typeof trip.heroImage === "string" ? trip.heroImage : trip.heroImage?.src;
      let heroImageData;

      if (trip.heroImage) {
        if (typeof trip.heroImage === "string" && trip.heroImage.startsWith("/src/assets/images/") && trip.slug === "sola-terra-frankrijk") {
          heroImageData = await getImage({ src: terraImage, width: 1400, quality: 85 });
          imageUrl = heroImageData.src;
        } else if (typeof trip.heroImage !== "string") {
          heroImageData = await getImage({ src: trip.heroImage, width: 1400, quality: 85 });
          imageUrl = heroImageData.src;
        }
      }

      return { params: { slug: trip.slug }, props: { trip: { ...trip, heroImage: imageUrl, heroImageData } } };
    }),
  );
}

const { trip } = Astro.props as { trip: Journey };
const isAltijdAan = trip.slug === "altijd-aan";
const { html: htmlContent, toc } = processMarkdown(trip.longread || "");
const metaDescriptionBase = `${trip.shortDescription} Locatie: ${trip.location}. Data: ${trip.dates}.`;
const metaDescription = metaDescriptionBase.length > 160 ? `${metaDescriptionBase.slice(0, 157).trimEnd()}...` : metaDescriptionBase;
const tripTitle = `SOLA Travel | ${trip.name} | ${trip.location}`;
const heroImageAlt = `${trip.name} in ${trip.location}`;
const baseUrl = Astro.site ?? Astro.url;
const canonicalUrl = new URL(Astro.url.pathname, baseUrl).toString();
const absoluteHeroImage = trip.heroImage ? new URL(trip.heroImage, baseUrl).toString() : undefined;
const priceValue = trip.price.match(/\d+([.,]\d+)?/g)?.join("");
const touristTripSchema = {
  "@context": "https://schema.org",
  "@type": "TouristTrip",
  name: trip.name,
  description: trip.shortDescription,
  image: absoluteHeroImage,
  url: canonicalUrl,
  provider: { "@type": "Organization", name: "SOLA", url: baseUrl.toString() },
  location: { "@type": "Place", name: trip.location },
  ...(priceValue ? { offers: { "@type": "Offer", price: priceValue, priceCurrency: "EUR", url: canonicalUrl } } : {}),
};
const altijdAanIntro = [
  "Je traint. Je slaapt. Je eet goed. En toch voel je dat je niet volledig herstelt.",
  "Je neemt rust, maar je lichaam blijft alert. Je slaapt voldoende, maar wordt niet echt opgeladen wakker.",
  "Tijdens dit weekend leer je begrijpen waarom je lichaam moeilijk terugschakelt van actie naar herstel en welke rol slaap, dagritme, prikkels, ademhaling en beweging daarin spelen.",
];
---

<BaseLayout title={tripTitle} description={metaDescription} ogImage={trip.heroImage} ogImageAlt={heroImageAlt} structuredData={touristTripSchema}>
  <section class="relative bg-base-900 text-white">
    {trip.heroImage && <img class="absolute inset-0 h-full w-full object-cover opacity-45" src={trip.heroImage} width={trip.heroImageData?.width ?? 1400} height={trip.heroImageData?.height ?? 933} alt={heroImageAlt} loading="eager" decoding="async" fetchpriority="high" />}
    <div class="relative mx-auto max-w-6xl space-y-6 px-6 py-24">
      <p class="text-xs uppercase tracking-[0.25em] text-white/70">{trip.type}</p>
      <h1 class="text-4xl font-semibold lg:text-5xl">{trip.name}</h1>
      {trip.subtitle && <p class="max-w-2xl text-2xl font-semibold">{trip.subtitle}</p>}
      {isAltijdAan && <div class="max-w-2xl space-y-3 text-white/85">{altijdAanIntro.map((paragraph) => <p>{paragraph}</p>)}</div>}
      <div class="flex flex-wrap gap-3 text-sm">
        <span class="rounded-full border border-white/30 bg-white/15 px-3 py-1">{trip.location}</span>
        <span class="rounded-full border border-white/30 bg-white/15 px-3 py-1">{trip.dates}</span>
        <span class="rounded-full border border-white/30 bg-white/15 px-3 py-1">{trip.price}</span>
      </div>
      {trip.statusLabel && <p class="text-sm font-semibold text-white/80">{trip.statusLabel}</p>}
      <div class="flex flex-wrap gap-3">
        {trip.ctaHref ? <a href={trip.ctaHref} target="_blank" rel="noreferrer" class="inline-flex rounded-full bg-accent-600 px-5 py-3 font-semibold text-white hover:bg-accent-700">{trip.ctaLabel ?? "Ik heb interesse"}</a> : <a href="#content" class="inline-flex rounded-full bg-base-25 px-5 py-3 font-semibold text-base-900">Lees meer</a>}
        <a href="/contact" class="inline-flex rounded-full border border-white/60 px-5 py-3 font-semibold text-white">Plan een gesprek</a>
      </div>
    </div>
  </section>

  {isAltijdAan && <AltijdAanContent />}

  {!isAltijdAan && htmlContent && (
    <section id="content" class="mx-auto max-w-6xl px-6 py-14">
      <div class="flex flex-col gap-8 lg:flex-row">
        {toc.length > 0 && <aside class="shrink-0 lg:w-64"><div class="sticky top-6"><h2 class="mb-4 text-lg font-semibold text-base-900">Inhoudsopgave</h2><nav class="space-y-2">{toc.map((item) => <a href={`#${item.id}`} class={`block text-sm text-base-600 transition-colors hover:text-accent-600 ${item.level === 2 ? "font-medium" : item.level === 3 ? "ml-4" : item.level === 4 ? "ml-8" : ""}`}>{item.text}</a>)}</nav></div></aside>}
        <div class="min-w-0 flex-1">
          <div class="prose prose-lg prose-base-900 max-w-none prose-headings:font-semibold prose-headings:text-base-900 prose-h2:mt-12 prose-h2:mb-6 prose-h2:scroll-mt-6 prose-h2:text-2xl prose-h3:mt-8 prose-h3:mb-4 prose-h3:scroll-mt-6 prose-h3:text-xl prose-h4:mt-6 prose-h4:mb-3 prose-h4:scroll-mt-6 prose-h4:text-lg prose-p:mb-4 prose-p:leading-relaxed prose-p:text-base-700 prose-ul:my-4 prose-ul:text-base-700 prose-li:my-2 prose-strong:font-semibold prose-strong:text-base-900 prose-a:text-accent-600 prose-a:no-underline hover:prose-a:underline" set:html={htmlContent} />
        </div>
      </div>
    </section>
  )}
</BaseLayout>
