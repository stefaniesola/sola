---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import landscape from '../../assets/images/gut-feeling/hero.webp';
import ontbijt from '../../assets/images/gut-feeling/ontbijt.webp';
import justine from '../../assets/images/gut-feeling/justine.webp';
import sarah from '../../assets/images/gut-feeling/sarah.webp';
import food from '../../assets/images/gut-feeling/maaltijd.webp';
const interestHref = 'https://tally.so/r/lbQGek';
const interestCta = 'Zet me op de interesselijst';
const sections = [['voor-wie','Voor wie'],['wat-je-leert','Wat je leert'],['programma','Programma'],['begeleiding','Begeleiding'],['praktisch','Praktisch'],['faq','FAQ'],['contact','Contact']];
const topics = [
 ['Understand your gut','Waarom voel je je soms opgeblazen of moe? Sarah legt uit wat er in je darmen gebeurt, wat goed functionerende darmen nodig hebben en welke rol voeding daarin speelt. Zonder moeilijke taal, met het hoe en het waarom.'],
 ['Suikerregulatie en energie','Hoe komt suiker in je cellen en waarom schommelt je energie? Je ontdekt hoe wat je eet samenhangt met je energie doorheen de dag, en waarom je ontbijt daarbij een belangrijke rol speelt.'],
 ['Van kennis naar je eigen keuken','Met Justine vertaal je de inzichten naar gerechten die je thuis ook echt maakt. Je kookt met ingrediënten uit haar moestuin en krijgt tips, recepten en haalbare gewoontes mee.'],
 ['Fermenteren','In een praktische workshop ontdek en proef je hoe fermenteren werkt, en hoe je er thuis zelf mee aan de slag gaat.'],
];
const programme = [
 ['10.00','Welkom','Onthaal en kennismaking met de groep, Justine, Sarah en Stefanie.'],
 ['10.30','Understand your gut','Wat gebeurt er in je darmen en welke rol speelt voeding hierin? Uitleg over darmgezondheid, suikerregulatie en energie, met Sarah.'],
 ['11.30','Vragen en dialoog','Ruimte voor persoonlijke vragen, herkenbare situaties en inzichten uit de groep.'],
 ['12.00','Cook & connect','Samen koken onder begeleiding van Justine, met ingrediënten uit haar moestuin.'],
 ['13.30','Lunch samen','Aan tafel met wat je samen klaarmaakte.'],
 ['14.30','From knowledge to practice','Hoe vertaal je de inzichten naar je eigen keuken? Tips, recepten en haalbare gewoontes, met Sarah en Justine.'],
 ['15.30','Taste & discover','Fermentatieworkshop met Justine.'],
 ['16.30','Takeaways','Afsluiten, laatste vragen en recepten mee naar huis.'],
];
const faqs = [
 ['Heb ik kookervaring nodig?','Nee. Je hoeft geen ervaren kok te zijn. Je leert al doende en gaat samen met Justine en de andere deelnemers aan de slag.'],
 ['Voor wie is deze dag?','Voor iedereen die graag lekker eet en meer wil begrijpen van voeding, darmgezondheid en energie. Je bent welkom alleen, met je partner, een vriend of vriendin. Je hebt geen kookervaring of voorkennis nodig.'],
 ['Krijg ik persoonlijk voedingsadvies?','Nee. Je krijgt uitleg over hoe je lichaam werkt en praktische inspiratie voor je eigen keuken. Een persoonlijk dieetadvies of een voedingsschema op maat hoort daar niet bij. Daarvoor ga je best naar een diëtist.'],
 ['Krijg ik recepten mee naar huis?','Ja. Je gaat naar huis met de recepten van de dag en praktische handvatten om thuis verder te gaan.'],
 ['Kan ik een allergie of voedingswens doorgeven?','Ja. Geef die bij je inschrijving door, zodat we kunnen afstemmen wat mogelijk is.'],
 ['Hoe groot is de groep?','De dag gaat door met 8 tot 15 deelnemers.'],
 ['Waar gaat de dag door en wat kost hij?','De locatie en de prijs maken we binnenkort bekend. Zet je op de interesselijst, dan ontvang je die informatie als eerste.'],
];
---
<BaseLayout title="Gut Feeling | SOLA Travel" description="SOLA-dag over koken, darmgezondheid en energie met Justine en Sarah Deleu. Zaterdag 2 oktober 2027, van 10.00 tot 17.00 uur. Locatie en prijs volgen.">
 <section class="hero">
  <Image src={landscape} alt="Verse appels, klaar om mee te koken" class="hero-image" loading="eager" />
  <div class="wrap hero-inner"><p class="kicker">SOLA-dag met Justine Deleu en Sarah Deleu</p><h1>Gut Feeling</h1><h2>Lekker koken. Je darmen begrijpen.<br />Meer uit je voeding halen.</h2><p class="intro">Lekker eten, samen koken en begrijpen wat voeding doet met je darmen en je energie. Tijdens deze SOLA-dag combineer je een kookworkshop met onderbouwde kennis. Sarah Deleu, biomedisch wetenschapper en orthomoleculair therapeut, legt de werking van je lichaam uit. Justine Deleu vertaalt die inzichten naar de keuken.</p><p class="intro">Je kookt, luncht samen, ontdekt fermenteren en gaat naar huis met recepten en nieuwe inzichten. Geen kookervaring nodig. Wel goesting om thuis verder te doen.</p><div class="pills"><span>Zaterdag 2 oktober 2027</span><span>10.00–17.00 uur</span><span>8 tot 15 deelnemers</span></div><p>Locatie en prijs volgen · zet je alvast op de interesselijst</p><div class="actions"><a class="button" href={interestHref}>{interestCta}</a><a class="button outline" href="https://calendly.com/hello-solatravel/30min">Plan een gesprek</a></div></div>
 </section>
 <div class="wrap facts"><div><p class="kicker">Wanneer</p><strong>Zaterdag 2 oktober 2027</strong><p>Van 10.00 tot 17.00 uur</p></div><div><p class="kicker">Waar</p><strong>Locatie volgt</strong><p>Wordt binnenkort bekendgemaakt</p></div><div><p class="kicker">Prijs</p><strong>Prijs volgt</strong><p>Lunch inbegrepen</p></div><div><p class="kicker">Groep</p><strong>8 tot 15</strong><p>deelnemers</p></div></div>
 <nav class="page-nav" aria-label="Op deze pagina"><div class="wrap"><strong>Op deze pagina</strong>{sections.map(([id,label])=><a href={`#${id}`}>{label}</a>)}</div></nav>
 <main class="wrap body">
  <section id="voor-wie"><p class="kicker">Voor wie?</p><h2>Graag lekker eten en gezonder koken, zonder gedoe?</h2><p>Voel je je soms opgeblazen of moe en vraag je je af welke rol je voeding daarin speelt? Wil je je suikerspiegel beter begrijpen of ontdekken wat je darmen nodig hebben? En doe je dat graag al kokend, proevend en samen met anderen?</p><p>Deze dag is voor jou als je:</p><ul><li>graag lekker eet en gezonder wilt koken, zonder ingewikkelde technieken</li><li>je suikerspiegel en energiedips beter wilt begrijpen</li><li>nieuwsgierig bent naar voeding en darmgezondheid</li><li>gezond koken haalbaar wilt maken voor jezelf of je gezin</li><li>wilt kennismaken met fermenteren</li></ul><p><strong>Kookervaring is niet nodig.</strong> Je leert al doende en kookt samen.</p></section>
  <section class="panel"><p class="kicker">Na deze dag</p><h2>Nieuwe recepten. Heldere inzichten. Goesting om te koken.</h2><ul><li>eenvoudige, lekkere recepten die je meteen kunt uitproberen</li><li>meer inzicht in je darmen, je suikerspiegel en de rol van voeding</li><li>praktische handvatten voor bewuste keuzes op je bord</li><li>de basis om thuis zelf te fermenteren</li><li>inspiratie om gezond koken in je dagelijkse routine te passen</li></ul></section>
  <section id="wat-je-leert"><p class="kicker">Wat je leert</p><h2>De wetenschap achter wat je eet</h2><p>Tijdens deze dag gaan genieten en gezond eten hand in hand. De rode draad is een kookworkshop met onderbouwde kennis: je kookt samen, proeft, stelt vragen en ontdekt het waarom achter wat je klaarmaakt.</p><div class="grid">{topics.map(([title,copy])=><article><h3>{title}</h3><p>{copy}</p></article>)}</div></section>
  <section id="programma"><p class="kicker">Zaterdag 2 oktober 2027 · 10.00–17.00 uur</p><h2>Programma</h2><p>Theorie en praktijk wisselen elkaar af. Onderstaande indeling geeft je een idee van de dag. De precieze invulling wordt nog verfijnd.</p><ol class="timeline">{programme.map(([time,title,copy])=><li><span class="time">{time}</span><div><h3>{title}</h3><p>{copy}</p></div></li>)}</ol></section>
  <section id="begeleiding"><p class="kicker">Expertise & coördinatie</p><div class="grid profiles"><article><Image src={justine} alt="Justine Deleu" width={580} height={500} /><h2>Justine Deleu</h2><p class="kicker">Gezond en lekker koken · culinaire begeleiding</p><p>Justine is de vertrouwde kok achter de maaltijden tijdens de SOLA-weekends. Met een grote portie passie voor gezond en lekker eten laat ze je ontdekken hoeveel smaak er in eenvoudige gerechten kan zitten. Veel ingrediënten komen uit haar eigen moestuin: verse oogst die mee de gerechten van de dag bepaalt.</p><p>Tijdens deze dag sta je samen met haar in de keuken. Je kookt, proeft, fermenteert en leert recepten maken voor een gewone weekdag én een feestelijke tafel.</p></article><article><Image src={sarah} alt="Sarah Deleu van Logisch Gezond" width={580} style="object-position:center 55%" /><h2>Sarah Deleu</h2><p class="kicker">Logisch Gezond · biomedisch wetenschapper en orthomoleculair therapeut</p><p>Sarah Deleu is biomedisch wetenschapper en orthomoleculair therapeut bij Logisch Gezond. Ze combineert haar wetenschappelijke achtergrond met haar praktijkervaring en vertaalt de werking van het lichaam naar begrijpelijke uitleg over voeding, suikerregulatie en darmgezondheid.</p><a href="https://logisch-gezond.be/" target="_blank" rel="noopener noreferrer">Meer over Logisch Gezond ↗</a></article></div><p class="coordination">Stefanie Deleu verzorgt het welkom, de afsluiting en de coördinatie van de dag.</p></section>
  <section class="meal"><Image src={food} alt="Verse gerechten tijdens een SOLA-weekend" width={650} /><div><p class="kicker">Samen aan tafel</p><h2>Koken, proeven en genieten</h2><p>De lunch is inbegrepen: je eet samen wat je onder begeleiding van Justine klaarmaakte, met veel ingrediënten uit haar eigen moestuin. In de namiddag proef je ook wat je tijdens de fermentatieworkshop ontdekt.</p><p>Heb je een allergie, voedingswens of een specifieke vraag? Geef die vooraf door, zodat we kunnen afstemmen wat mogelijk is.</p></div></section>
  <section class="weekend-gallery"><div class="grid photos"><Image src={ontbijt} alt="Ontbijtinspiratie met yoghurt, fruit en granola" width={650} /><Image src={landscape} alt="Verse appels, klaar om mee te koken" width={650} /></div></section>
  <section id="praktisch" class="panel"><p class="kicker">Praktisch</p><h2>Binnenkort meer</h2><ul><li>zaterdag 2 oktober 2027, van 10.00 tot 17.00 uur</li><li>8 tot 15 deelnemers</li><li>lunch, recepten en alle workshops inbegrepen</li><li>locatie en prijs volgen</li></ul><p>Zet je op de interesselijst. Je ontvangt de locatie, de prijs en bericht zodra de inschrijvingen openen. Je interesse is vrijblijvend.</p><a class="button" href={interestHref}>{interestCta}</a></section>
  <section id="contact"><h2>Twijfel je nog?</h2><p>Wil je eerst weten of deze dag bij je past? Plan een gesprek met SOLA.</p><div class="actions"><a class="button" href="https://calendly.com/hello-solatravel/30min">Plan een gesprek</a><a class="text-link" href="https://wa.me/32493410738">Stuur een WhatsApp</a><a class="text-link" href="tel:+32493410738">Bel Stefanie</a></div></section>
  <section id="faq"><p class="kicker">Goed om te weten</p><h2>Veelgestelde vragen</h2>{faqs.map(([question,answer])=><details><summary>{question}</summary><p>{answer}</p></details>)}</section>
 </main>
 <section class="closing"><div class="wrap"><p class="kicker">Zaterdag 2 oktober 2027 · 10.00–17.00 uur · 8 tot 15 deelnemers</p><h2>Neem je Gut Feeling mee naar huis</h2><p>Samen koken, lekker eten en bijleren. Je gaat naar huis met recepten, inzichten en nieuwe inspiratie voor je eigen keuken. Voor jezelf en wie je graag ziet.</p><p><strong>Locatie en prijs volgen</strong></p><a class="button" href={interestHref}>{interestCta}</a></div></section>
</BaseLayout>
<style>
 .wrap{max-width:1152px;margin:auto;padding:0 24px}.hero{position:relative;background:#3e342a;color:#fff}.hero-image{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.24}.hero-inner{position:relative;padding-top:85px;padding-bottom:75px}.kicker{font-size:.75rem;letter-spacing:.13em;text-transform:uppercase;font-weight:600;color:#9a4929;margin-bottom:12px}.hero .kicker,.closing .kicker{color:#e4c7ae}h1{font-size:clamp(3.5rem,9vw,6.5rem);line-height:1;letter-spacing:-.04em;margin:18px 0 24px;font-weight:600}h2{font-size:clamp(1.8rem,3.4vw,2.6rem);line-height:1.15;letter-spacing:-.025em;font-weight:600;margin-bottom:22px}h3{font-size:1.45rem;font-weight:600;line-height:1.25;margin:22px 0 12px}p{line-height:1.65;margin-bottom:16px}.intro{max-width:740px}.pills,.actions{display:flex;flex-wrap:wrap;gap:12px;margin:25px 0}.pills span{border:1px solid #fff6;border-radius:30px;padding:7px 15px;font-size:.9rem}.button{display:inline-flex;border-radius:40px;background:#aa5432;color:white;padding:14px 25px;font-weight:600;align-items:center;text-decoration:none}.button:hover{background:#874024}.outline{border:1px solid #fff9;background:transparent}.text-link{align-self:center;text-decoration:underline}.facts{display:grid;grid-template-columns:repeat(4,1fr);gap:25px;padding-top:35px;padding-bottom:22px}.facts strong{font-size:1.1rem}.facts p{font-size:.9rem}.page-nav{border-block:1px solid #ddd3c7}.page-nav .wrap{display:flex;gap:20px;flex-wrap:wrap;padding-top:20px;padding-bottom:20px;font-size:.85rem}.page-nav a:hover{color:#aa5432}.body{padding-top:10px;padding-bottom:50px;color:#3e342a}.body section{margin:65px 0;scroll-margin-top:110px}.body section>p{max-width:900px}ul{list-style:disc;padding-left:24px;line-height:1.7}li{padding:4px 0}.panel{background:#eee8df;padding:35px;border-radius:16px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:35px;margin-top:30px}.profiles img{width:100%;height:350px;object-fit:cover;border-radius:12px}.profiles img{object-position:center 30%}.profiles h2{margin-top:25px}.profiles a{text-decoration:underline}.photos img{width:100%;height:300px;object-fit:cover;border-radius:12px}.meal{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:center}.meal>img{width:100%;height:450px;object-fit:cover;border-radius:12px}details{border-bottom:1px solid #d8cfc2;padding:18px 0}summary{cursor:pointer;font-weight:600;font-size:1.1rem}details>div,details>p{padding:15px 0 0;margin:0}details h3{margin-top:0}.closing{background:#3e342a;color:#fff;padding:65px 0}.closing p{max-width:740px}.closing .button{margin-top:10px}a:focus-visible,summary:focus-visible{outline:3px solid #d16a3c;outline-offset:5px}@media(max-width:700px){.facts,.grid,.meal{grid-template-columns:1fr}.facts{grid-template-columns:1fr 1fr;gap:15px}.hero-inner{padding-top:55px;padding-bottom:45px}.body section{margin:45px 0}.panel{padding:24px}.profiles img{height:340px}.meal>img{height:280px}.page-nav .wrap{gap:12px}.photos img{height:250px}}
 .timeline{list-style:none;padding:0;margin-top:30px;border-top:1px solid #d8cfc2}.timeline li{display:grid;grid-template-columns:90px 1fr;gap:20px;padding:20px 0;border-bottom:1px solid #d8cfc2}.timeline .time{font-weight:600;color:#9a4929;font-size:1.1rem}.timeline h3{margin:0 0 6px}.timeline p{margin:0}.coordination{margin-top:30px}@media(max-width:700px){.timeline li{grid-template-columns:64px 1fr;gap:12px}}
</style>
