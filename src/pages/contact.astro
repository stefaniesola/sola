---
import BaseLayout from "../layouts/BaseLayout.astro";
import { contactPage } from "../data/content";
---

<BaseLayout
  title={contactPage.title}
  description={contactPage.metaDescription}
>
  <section class="bg-base-50/80 border-b border-base-200">
    <div class="max-w-4xl mx-auto px-6 py-16 space-y-4">
      <p class="uppercase text-xs tracking-[0.25em] text-base-500">
        {contactPage.label}
      </p>
      <h1 class="text-4xl font-semibold text-base-900">
        {contactPage.heading}
      </h1>
      <div class="space-y-2 text-base-700">
        <p>
          Stuur ons een bericht of plan een gesprek. We antwoorden snel via
          <a
            class="text-accent-700 hover:text-accent-800"
            href="mailto:hello@solatravel.be"
            data-meta-event="Contact"
            data-meta-content-name="SOLA algemeen contact"
            data-meta-content-category="Contact"
          >
            hello@solatravel.be
          </a>.
        </p>
        <div class="flex flex-wrap items-center gap-3 pt-2">
          <a href="https://calendly.com/hello-solatravel/30min" target="_blank" rel="noopener noreferrer" data-meta-event="Contact" data-meta-content-name="SOLA algemeen contact" data-meta-content-category="Contact" class="inline-flex min-h-11 items-center rounded-full bg-accent-700 px-5 py-3 font-semibold text-white hover:bg-accent-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4">Plan een gesprek</a>
          <a href="https://wa.me/32493410738?text=Hallo%20Stefanie%2C%20ik%20heb%20een%20korte%20vraag%20over%20SOLA." target="_blank" rel="noopener noreferrer" data-meta-event="Contact" data-meta-content-name="SOLA algemeen contact" data-meta-content-category="Contact" class="inline-flex min-h-11 items-center rounded-full border border-base-400 px-5 py-3 font-semibold text-accent-700 hover:border-accent-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4">Stuur een WhatsApp</a>
          <a href="tel:+32493410738" data-meta-event="Contact" data-meta-content-name="SOLA algemeen contact" data-meta-content-category="Contact" class="inline-flex min-h-11 items-center px-1 font-semibold text-accent-700 underline underline-offset-4 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4">Bel Stefanie · +32 493 410 738</a>
        </div>
        <p class="pt-2 text-sm text-base-600">Word je liever opgebeld? <a href="https://wa.me/32493410738?text=Hallo%20Stefanie%2C%20wil%20je%20me%20terugbellen%3F%20Mijn%20telefoonnummer%20is%20...%20en%20dit%20moment%20past%20voor%20mij%3A%20..." target="_blank" rel="noopener noreferrer" data-meta-event="Contact" data-meta-content-name="SOLA algemeen contact" data-meta-content-category="Contact" class="text-accent-700 underline underline-offset-4 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4">Laat me via WhatsApp weten wanneer het past.</a></p>
      </div>
    </div>
  </section>

  <section
    class="max-w-6xl mx-auto px-6 py-14 grid lg:grid-cols-[2fr,1fr] gap-10"
  >
    <div class="p-6 rounded-2xl border border-base-200 bg-base-25 shadow-sm">
      <div class="notion-embed-wrapper">
        <iframe
          id="contact-form"
          src="https://tally.so/r/yP4R2x"
          width="100%"
          frameborder="0"
          allowfullscreen
          style="min-height: 900px; border: none;"></iframe>
      </div>
    </div>
  </section>
</BaseLayout>
