---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "SOLA Merch | Performance shirt voor hikes, trailruns en outdoor avontuur";
const description =
  "Licht en ademend SOLA performance shirt voor hikes, trailruns, fietsen en outdoor avontuur. Ontworpen voor mensen die bewust kiezen voor beweging.";
const baseUrl = Astro.site ?? Astro.url;
const absoluteUrl = (path: string) => new URL(path, baseUrl).toString();
const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: "SOLA Performance Tee",
  description,
  brand: { "@type": "Brand", name: "SOLA" },
  image: [
    absoluteUrl("/images/sola-performance-tee-front.png"),
    absoluteUrl("/images/sola-performance-tee-back.png"),
  ],
  itemCondition: "https://schema.org/NewCondition",
  offers: {
    "@type": "Offer",
    price: "40",
    priceCurrency: "EUR",
    availability: "https://schema.org/LimitedAvailability",
    url: absoluteUrl("/merch"),
  },
};

const features = [
  "Technische ademende stof",
  "Unisex pasvorm",
  "Beperkte eerste oplage",
];
---

<BaseLayout {title} description={description} structuredData={productSchema}>
  <section class="border-b border-base-200 bg-base-50/80">
    <div class="mx-auto max-w-6xl px-6 py-10 lg:py-12">
      <div class="max-w-4xl space-y-5">
        <p class="text-xs font-semibold uppercase tracking-[0.25em] text-base-500">SOLA Merch</p>
        <h1 class="text-4xl font-semibold leading-tight text-base-900 sm:text-5xl lg:text-6xl">
          SOLA Performance Tee
        </h1>
        <p class="max-w-3xl text-xl leading-relaxed text-base-800">
          Voor hikes. Trailruns. Yoga. Pilates. Hyrox. En alles daartussen.
        </p>
        <p class="max-w-2xl text-lg leading-relaxed text-base-700">
          Licht, ademend en gemaakt om te bewegen.
        </p>
        <p class="text-xl font-semibold text-base-900">
          €40 <span class="text-base font-normal text-base-600">incl. verzending in België</span>
        </p>
        <a
          href="#bestellen"
          class="inline-flex items-center justify-center rounded-full bg-accent-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-accent-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500/50"
        >
          Bestel jouw shirt
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto grid max-w-6xl gap-6 px-6 py-10 lg:grid-cols-2 lg:items-stretch lg:py-12">
    <div class="flex min-h-[420px] flex-col justify-between border border-base-200 bg-base-25 p-6 sm:p-8">
      <div class="space-y-3">
        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-accent-700">Eerste oplage</p>
        <h2 class="text-3xl font-semibold leading-tight text-base-900">Waarom dit shirt?</h2>
      </div>
      <div class="mt-8">
        <ul class="divide-y divide-base-200 border-y border-base-200">
          {features.map((feature) => <li class="py-4 text-lg text-base-800">{feature}</li>)}
        </ul>
        <p class="mt-6 leading-relaxed text-base-700">
          Ontwikkeld samen met <a
            class="font-semibold text-accent-700 underline-offset-4 hover:text-accent-800 hover:underline"
            href="https://www.decca.cc"
            target="_blank"
            rel="noopener noreferrer">Decca Sportswear</a
          >, Belgische specialist in technische sportkleding.
        </p>
      </div>
    </div>
    <div class="relative min-h-[420px] overflow-hidden bg-base-100 p-6 sm:p-8">
      <img
        class="h-full w-full object-contain"
        src="/images/sola-performance-tee-front.png"
        alt="Voorzijde van het SOLA Performance Tee"
        loading="eager"
        decoding="async"
      />
    </div>
  </section>

  <section class="bg-base-50/70">
    <div class="mx-auto max-w-4xl px-6 py-8 text-center lg:py-10">
      <h2 class="text-3xl font-semibold leading-tight text-base-900 lg:text-4xl">
        Voor wie niet gewoon weg, maar vooruit wil.
      </h2>
    </div>
  </section>

  <section id="bestellen" class="mx-auto max-w-6xl px-6 py-10 lg:py-12">
    <div class="grid gap-6 lg:grid-cols-[minmax(0,0.72fr)_minmax(340px,0.58fr)] lg:items-start">
      <div class="space-y-4">
        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-accent-700">Bestellen via formulier</p>
        <h2 class="text-3xl font-semibold text-base-900">Vul je maat en aantal in.</h2>
        <p class="max-w-xl leading-relaxed text-base-700">
          €40 inclusief verzending binnen België. We bevestigen je bestelling en betaling per mail.
        </p>
      </div>
      <div class="border border-base-200 bg-white p-3 shadow-sm sm:p-5">
        <iframe
          data-tally-src="https://tally.so/embed/2E7Myp?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1"
          loading="lazy"
          width="100%"
          height="560"
          frameborder="0"
          title="Bestel SOLA Performance Tee"
          class="w-full"
        ></iframe>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 pb-12 lg:pb-16">
    <details class="group border-y border-base-200">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 text-lg font-semibold text-base-900 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500/40">
        <span>Ontwerpdetails</span>
        <span aria-hidden="true" class="text-2xl font-light leading-none text-base-500 transition-transform group-open:rotate-45">+</span>
      </summary>
      <div class="border-t border-base-200 pb-8 pt-6">
        <p class="text-base-700">
          Ontwikkeld samen met <a
            class="font-semibold text-accent-700 underline-offset-4 hover:text-accent-800 hover:underline"
            href="https://www.decca.cc"
            target="_blank"
            rel="noopener noreferrer">Decca Sportswear</a
          >.
        </p>
        <div class="mt-6 grid gap-8 md:grid-cols-2">
          <figure class="mx-auto w-full max-w-[560px]">
            <a href="/images/sola-performance-tee-front.png" target="_blank" rel="noopener noreferrer" aria-label="Bekijk de voorzijde van het SOLA Performance Tee ontwerp op volledig formaat">
              <img class="w-full rounded object-contain transition-opacity hover:opacity-90" src="/images/sola-performance-tee-front.png" alt="Ontwerp van de voorzijde van het SOLA Performance Tee" loading="lazy" decoding="async" />
            </a>
            <figcaption class="mt-3 text-sm text-base-600">Voorzijde</figcaption>
          </figure>
          <figure class="mx-auto w-full max-w-[560px]">
            <a href="/images/sola-performance-tee-back.png" target="_blank" rel="noopener noreferrer" aria-label="Bekijk de achterzijde van het SOLA Performance Tee ontwerp op volledig formaat">
              <img class="w-full rounded object-contain transition-opacity hover:opacity-90" src="/images/sola-performance-tee-back.png" alt="Ontwerp van de achterzijde van het SOLA Performance Tee" loading="lazy" decoding="async" />
            </a>
            <figcaption class="mt-3 text-sm text-base-600">Achterzijde</figcaption>
          </figure>
        </div>
      </div>
    </details>
  </section>

  <script is:inline>
    const loadTallyEmbeds = () => {
      if (window.Tally) {
        window.Tally.loadEmbeds();
        return;
      }
      document.querySelectorAll("iframe[data-tally-src]:not([src])").forEach((iframe) => {
        iframe.src = iframe.dataset.tallySrc;
      });
    };
    if (!document.querySelector('script[src="https://tally.so/widgets/embed.js"]')) {
      const script = document.createElement("script");
      script.src = "https://tally.so/widgets/embed.js";
      script.onload = loadTallyEmbeds;
      script.onerror = loadTallyEmbeds;
      document.body.appendChild(script);
    } else {
      loadTallyEmbeds();
    }
  </script>
</BaseLayout>

