---
import BaseLayout from "../layouts/BaseLayout.astro";
import { homeCopy, journeys, people, homePage } from "../data/content";
import { getImage } from "astro:assets";
import heroImage from "../assets/images/Stefanie Deleu - Haute Loire.jpg";
import exerciseImage from "../assets/images/2596052607.jpg";
import bewustwordingImage from "../assets/images/2631991747.jpg";
import terraImage from "../assets/images/1513986998.jpg";
import hauteLoireImage from "../assets/images/haute-loire.jpg";
import verblijfHogeVenenImage from "../assets/images/Verblijf in Hoge Venen.avif";
import natureImage from "../assets/images/GeoPark Famenne Ardenne - landschap Hoge Venen (6).jpg";
import altijdAanCardImage from "../assets/images/GeoPark Famenne Ardenne - landschap Hoge Venen (6).jpg";
import jorienPortrait from "../assets/images/jorien-raeymaekers.jpg";

const dutchMonthMap: Record<string, number> = {
  januari: 0,
  februari: 1,
  maart: 2,
  april: 3,
  mei: 4,
  juni: 5,
  juli: 6,
  augustus: 7,
  september: 8,
  oktober: 9,
  november: 10,
  december: 11,
};

const getJourneyStartDate = (dates: string) => {
  const normalized = dates.toLowerCase().replace(/\s+/g, " ").trim();
  const match = normalized.match(/(\d{1,2}).*?([a-zà-ÿ]+).*?(\d{4})/i);

  if (!match) {
    return Number.POSITIVE_INFINITY;
  }

  const day = Number.parseInt(match[1], 10);
  const month = dutchMonthMap[match[2]];
  const year = Number.parseInt(match[3], 10);

  if (Number.isNaN(day) || Number.isNaN(year) || month === undefined) {
    return Number.POSITIVE_INFINITY;
  }

  return new Date(year, month, day).getTime();
};

const weekendHighlights = journeys
  .filter(
    (journey) =>
      journey.type === "Weekend" &&
      ["exercise-is-medicine", "bewustwording-connectie"].includes(journey.slug),
  )
  .sort((a, b) => getJourneyStartDate(a.dates) - getJourneyStartDate(b.dates));
const nextEdition = journeys.find((journey) => journey.slug === "altijd-aan");
const altijdAanBookingHref = "https://tally.so/r/pbogoy";
const returningWeekendInterestLinks: Record<string, string> = {
  "exercise-is-medicine": "https://tally.so/r/QKqRJA",
  "bewustwording-connectie": "https://tally.so/r/b5Me82",
};
const homeReviews = [
  {
    name: "Wafa",
    quote: "Frisse straal in zelf(zorg)ontwikkeling, goeie combinatie van ontspanning en prikkels.",
  },
  {
    name: "Jana",
    quote: "deugdoend voor ziel en lijf",
  },
  {
    name: "Sarah",
    quote: "Good vibes op elk niveau, sport, kennis, voeding, in rust bijleren. Elkaar inspireren.",
  },
];
const founders = people.filter((person) => person.isTeamMember);
const linkClass = "text-accent-700 hover:text-accent-800";
const linkedWaarom = homeCopy.waarom;
const linkedOverOnsDescription = homePage.sectionOverOns.description.replaceAll(
  "reizen",
  `<a href="/reizen" class="${linkClass}">reizen</a>`,
);

// Get optimized hero image URL for background use
const optimizedHero = await getImage({
  src: heroImage,
  width: 1920,
  quality: 85,
});

// Process hero images for weekend highlights
const weekendHighlightsWithImages = await Promise.all(
  weekendHighlights.map(async (weekend) => {
    let imageUrl =
      typeof weekend.heroImage === "string"
        ? weekend.heroImage
        : weekend.heroImage?.src;
    let heroImageData;
    if (weekend.heroImage) {
      // If it's a local image path, process it
      if (typeof weekend.heroImage === "string") {
        if (weekend.heroImage.startsWith("/src/assets/images/")) {
          if (weekend.slug === "bewustwording-connectie") {
            heroImageData = await getImage({
              src: bewustwordingImage,
              width: 1600,
              quality: 90,
            });
            imageUrl = heroImageData.src;
          }
        }
      } else {
        heroImageData = await getImage({
          src: weekend.heroImage,
          width: 1600,
          quality: 90,
        });
        imageUrl = heroImageData.src;
      }
    }
    return { ...weekend, heroImage: imageUrl, heroImageData };
  }),
);

// Process images for pillars
const pillarsWithImages = await Promise.all(
  homeCopy.pillars.map(async (pillar, index) => {
    if (!pillar.image) return { ...pillar, imageUrl: null };

    let imageSrc;
    if (pillar.image === "/src/assets/images/2596052607.jpg") {
      imageSrc = exerciseImage;
    } else if (pillar.image === "/src/assets/images/2631991747.jpg") {
      imageSrc = bewustwordingImage;
    } else if (
      pillar.image === "/src/assets/images/Verblijf in Hoge Venen.avif"
    ) {
      imageSrc = verblijfHogeVenenImage;
    } else if (
      pillar.image ===
      "/src/assets/images/GeoPark Famenne Ardenne - landschap Hoge Venen (6).jpg"
    ) {
      imageSrc = natureImage;
    } else if (pillar.image === "/src/assets/images/1513986998.jpg") {
      imageSrc = terraImage;
    } else {
      return { ...pillar, imageUrl: null };
    }

    // Vary image sizes for visual interest
    const widths = [1200, 1400, 1000, 1600, 1100];
    const optimized = await getImage({
      src: imageSrc,
      width: widths[index % widths.length],
      quality: 90,
    });

    return { ...pillar, imageData: optimized };
  }),
);

// Optimize haute-loire image for founder section
const optimizedHauteLoire = await getImage({
  src: hauteLoireImage,
  width: 1200,
  quality: 90,
});
---

<BaseLayout
  title={homePage.title}
  description={homePage.description}
  ogImage={optimizedHero.src}
  ogImageAlt="SOLA reiservaring in de natuur"
>
  <section
    class="relative overflow-hidden min-h-screen sm:min-h-[700px] lg:min-h-[850px] hero-bg-animated"
  >
    <img
      class="absolute inset-0 w-full h-full hero-bg-animated"
      src={optimizedHero.src}
      width={optimizedHero.width}
      height={optimizedHero.height}
      alt="SOLA reiservaring in de natuur"
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
    <video
      class="hero-video absolute inset-0 w-full h-full object-cover object-center motion-reduce:hidden"
      autoplay
      muted
      playsinline
      loop
      preload="auto"
      poster={optimizedHero.src}
      aria-hidden="true"
    >
      <source src="/videos/homepage-runners.mp4" type="video/mp4" />
    </video>
    <div
      class="absolute inset-0 bg-gradient-to-r from-base-900/70 via-base-900/50 to-base-900/30"
    >
    </div>
    <div
      class="relative max-w-6xl mx-auto px-6 py-20 lg:py-28 grid lg:grid-cols-2 gap-12 items-center min-h-screen sm:min-h-[700px] lg:min-h-[850px]"
    >
      <div class="space-y-6">
        <p class="uppercase text-xs tracking-[0.25em] text-white/80">
          {homePage.brandLabel}
        </p>
        <h1 class="text-4xl lg:text-5xl font-semibold leading-tight text-white">
          {homeCopy.tagline}
        </h1>
        <p class="text-lg text-white/90 max-w-xl">{linkedWaarom}</p>
        <div class="flex flex-wrap gap-3">
          <a
            href="/reizen"
            class="inline-flex items-center justify-center px-5 py-3 rounded-full bg-accent-600 text-white font-semibold hover:bg-accent-700 transition"
          >
            {homePage.ctaDiscover}
          </a>
          <a
            href="/contact"
            class="inline-flex items-center justify-center px-5 py-3 rounded-full border border-white/40 text-white font-semibold hover:border-white/60 hover:bg-white/10"
          >
            {homePage.ctaContact}
          </a>
        </div>
      </div>
    </div>
  </section>

  {nextEdition && (
    <section class="bg-white">
    <div class="max-w-6xl mx-auto px-6 py-14 lg:py-20">
      <div class="mb-6">
        <h2 class="text-3xl font-semibold text-base-900">Volgend weekend</h2>
      </div>
      <article class="relative grid overflow-hidden rounded-3xl border border-base-200 bg-base-25 shadow-sm transition hover:shadow-lg lg:grid-cols-[1.15fr_1fr]">
        <a href="/reizen/altijd-aan" class="absolute inset-0 z-10" aria-label="Ontdek Altijd aan?"></a>
        <a href="/reizen/altijd-aan" class="group relative min-h-[280px] overflow-hidden bg-base-200 lg:min-h-[430px]">
          <img
            class="absolute inset-0 h-full w-full object-cover transition duration-500 group-hover:scale-[1.02]"
            src={altijdAanCardImage.src}
            width={altijdAanCardImage.width}
            height={altijdAanCardImage.height}
            alt={`${nextEdition.name} in ${nextEdition.location}`}
            loading="lazy"
            decoding="async"
          />
          <span class="absolute left-5 top-5 rounded-full bg-base-25 px-4 py-2 text-xs font-semibold uppercase tracking-wide text-base-900 shadow-sm">
            Volgend weekend
          </span>
        </a>
        <div class="flex flex-col justify-center p-7 sm:p-9 lg:p-12">
          <div class="flex flex-wrap items-center gap-3 text-xs uppercase tracking-wide text-base-500">
            <span class="rounded-full border border-base-200 bg-base-100 px-3 py-1">{nextEdition.location}</span>
            <span>{nextEdition.dates}</span>
          </div>
          <h2 class="mt-5 text-3xl font-semibold text-base-900 lg:text-4xl">{nextEdition.name}</h2>
          <div class="mt-4 flex items-start gap-4">
            <img
              src={jorienPortrait.src}
              width={jorienPortrait.width}
              height={jorienPortrait.height}
              alt="Jorien Raeymaekers"
              loading="lazy"
              decoding="async"
              class="h-16 w-16 shrink-0 rounded-full border-2 border-white object-cover shadow-sm sm:h-20 sm:w-20"
            />
            <p class="text-base leading-relaxed text-base-700">
              Samen met Jorien Raeymaekers onderzoek je hoe herstel fysiologisch werkt. Waarom blijft je systeem aan, ook wanneer je rust neemt? En hoe kan je je zenuwstelsel opnieuw leren schakelen via ademhaling, yoga, beweging en natuur?
            </p>
          </div>
          <div class="relative z-20 mt-7 flex flex-wrap items-center gap-3 border-t border-base-200 pt-5">
            <a href={altijdAanBookingHref} target="_blank" rel="noopener noreferrer" class="inline-flex items-center rounded-full bg-accent-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-accent-700">
              Boek nu
            </a>
            <a href="/reizen/altijd-aan" class="inline-flex items-center rounded-full border border-base-300 px-5 py-3 text-sm font-semibold text-base-900 transition hover:border-base-500 hover:bg-base-25">
              Ontdek het weekend
            </a>
            <a href={nextEdition.ctaHref} target="_blank" rel="noopener noreferrer" class="w-full pt-1 text-sm font-semibold text-base-700 underline decoration-base-300 underline-offset-4 transition hover:text-accent-700 hover:decoration-accent-600">
              {nextEdition.ctaLabel}
            </a>
          </div>
        </div>
      </article>
    </div>
    </section>
  )}

  <section class="border-y border-accent-700 bg-accent-600 text-white">
    <div class="max-w-6xl mx-auto px-6 py-12 lg:py-16">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-white/75">Ervaringen</p>
          <h2 class="mt-2 text-3xl font-semibold">Wat deelnemers meenamen</h2>
        </div>
        <div class="inline-flex w-fit items-center gap-3 rounded-full border border-white/20 bg-base-900 px-4 py-2 shadow-sm">
          <span class="text-2xl font-semibold leading-none">9/10</span>
          <span class="text-xs font-semibold uppercase tracking-[0.14em] text-white/75">Gemiddelde beoordeling</span>
        </div>
      </div>
      <div class="mt-8 grid gap-5 lg:grid-cols-3">
        {homeReviews.map((review) => (
          <blockquote class="relative flex h-full flex-col overflow-hidden border border-base-200 bg-base-25 p-6 text-base-900 shadow-lg sm:p-7">
            <span class="absolute -right-1 -top-5 font-serif text-8xl leading-none text-base-100" aria-hidden="true">“</span>
            <span class="relative text-3xl font-serif leading-none text-accent-600" aria-hidden="true">“</span>
            <p class="relative mt-3 flex-1 text-lg leading-relaxed text-base-800">{review.quote}</p>
            <footer class="relative mt-6 flex items-center gap-3 border-t border-base-100 pt-4">
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-base-900 text-sm font-semibold text-white" aria-hidden="true">{review.name.charAt(0)}</span>
              <span class="text-sm font-semibold text-base-900">{review.name}</span>
            </footer>
          </blockquote>
        ))}
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-6 pt-8 lg:pt-14 pb-0">
    <h2 class="text-3xl lg:text-4xl font-semibold text-base-900 text-center">
      Zo bouwen we elke SOLA-reis op
    </h2>
  </section>

  <section class="max-w-6xl mx-auto px-6 pt-2 lg:pt-4 pb-8 lg:pb-14 space-y-10 scroll-fade-in">
    <div class="space-y-8 lg:space-y-16 py-4 lg:py-8">
      <div class="space-y-8 lg:space-y-12">
        {
          pillarsWithImages.map((pillar, index) => {
            const isEven = index % 2 === 0;
            const hasBackground = index % 2 === 1;
            return (
              <div
                class={`flex flex-col lg:flex-row gap-12 items-center scroll-fade-in ${
                  isEven ? "lg:flex-row" : "lg:flex-row-reverse"
                } ${hasBackground ? "bg-base-50/50 rounded-3xl p-8 lg:p-12" : ""}`}
                style={`animation-delay: ${index * 0.2}s;`}
              >
                <div
                  class={`flex-1 space-y-4 ${isEven ? "lg:pr-8" : "lg:pl-8"}`}
                >
                  <h4 class="text-xl lg:text-2xl font-semibold text-base-900">
                    {pillar.title}
                  </h4>
                  <p class="text-lg text-base-700 leading-relaxed">
                    {pillar.description}
                  </p>
                </div>
                {pillar.imageData && (
                  <div class={`flex-1 ${isEven ? "lg:pl-8" : "lg:pr-8"}`}>
                    <div class="skewed-image-frame">
                      <img
                        class="skewed-image-inner"
                        src={pillar.imageData.src}
                        width={pillar.imageData.width}
                        height={pillar.imageData.height}
                        alt={pillar.title}
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                  </div>
                )}
              </div>
            );
          })
        }
      </div>
    </div>

    <style>
      .hero-bg-animated {
        object-fit: cover;
        object-position: center;
        animation: subtleMove 20s ease-in-out infinite alternate;
      }

      @keyframes subtleMove {
        0% {
          object-position: center center;
        }
        100% {
          object-position: 55% 45%;
        }
      }

      .skewed-image-frame {
        position: relative;
        padding: 0.25rem;
        background: linear-gradient(135deg, #f6f4f0 0%, #d6d2c8 100%);
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.2);
        overflow: hidden;
        border-radius: 1rem;
      }

      .skewed-image-inner {
        width: 100%;
        aspect-ratio: 16 / 9;
        object-fit: cover;
        object-position: center;
        display: block;
        margin: 0;
        border-radius: 0.75rem;
      }

      .scroll-fade-in {
        opacity: 0;
        transform: translateY(30px);
        transition:
          opacity 0.8s ease-out,
          transform 0.8s ease-out;
      }

      .scroll-fade-in.visible {
        opacity: 1;
        transform: translateY(0);
      }
    </style>

    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const observerOptions = {
          threshold: 0.1,
          rootMargin: "0px 0px -50px 0px",
        };

        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("visible");
            }
          });
        }, observerOptions);

        document.querySelectorAll(".scroll-fade-in").forEach((el) => {
          observer.observe(el);
        });
      });
    </script>
  </section>

  <div class="flex flex-col">
  <section class="order-2 bg-base-50/80 border-y border-base-200 scroll-fade-in">
    <div class="max-w-6xl mx-auto px-6 py-8 lg:py-14 space-y-8">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="uppercase text-xs tracking-[0.25em] text-base-500">
            Eerdere edities
          </p>
          <h3 class="text-3xl font-semibold text-base-900">
            Deze SOLA-weekenden keren terug in 2027
          </h3>
          <p class="mt-2 max-w-3xl text-base-700">
            Beweging als medicijn en Van inzicht naar verdiepend denken en voelen krijgen in 2027 een nieuwe editie. De nieuwe data worden later bekendgemaakt.
          </p>
        </div>
        <a class="text-sm font-semibold hover:text-accent-700" href="/reizen"
          >Bekijk alle reizen →</a
        >
      </div>
      <div class="relative">
      <div class="weekend-scroll-track" aria-label="Eerdere SOLA-edities">
        {
          weekendHighlightsWithImages.map((weekend) => (
            <article
              class="rounded-3xl border border-base-200 overflow-hidden bg-base-25 shadow-sm hover:shadow-lg transition flex flex-col group cursor-pointer"
            >
              <a
                href={`/weekenden/${weekend.slug}`}
                class="relative aspect-video bg-base-200 overflow-hidden"
              >
                {weekend.heroImage && (
                  <img
                    class="absolute inset-0 w-full h-full object-cover"
                    src={weekend.heroImage}
                    width={weekend.heroImageData?.width ?? 1600}
                    height={weekend.heroImageData?.height ?? 1067}
                    alt={`${weekend.name} in ${weekend.location}`}
                    loading="lazy"
                    decoding="async"
                  />
                )}
                <span class="absolute left-4 top-4 rounded-full bg-base-25/95 px-3 py-1.5 text-xs font-semibold uppercase tracking-wide text-base-800 shadow-sm">
                  Terug in 2027
                </span>
                <div class="absolute inset-0 bg-black/0 group-hover:bg-black/40 transition-all duration-300 flex items-center justify-center">
                  <span class="opacity-0 group-hover:opacity-100 transition-opacity duration-300 inline-flex items-center px-5 py-3 rounded-full bg-base-25 text-base-900 font-semibold">
                    Bekijk deze editie
                  </span>
                </div>
              </a>
              <div class="p-6 space-y-3 flex-1 flex flex-col">
                <div class="flex flex-col items-start gap-2 text-xs uppercase tracking-wide text-base-500 sm:flex-row sm:items-center sm:gap-3">
                  <span class="whitespace-nowrap px-3 py-1 rounded-full bg-base-100 border border-base-200">
                    {weekend.location}
                  </span>
                  <span>Eerdere editie · 31 juli – 2 augustus 2026</span>
                </div>
                <h4 class="text-xl font-semibold text-base-900">
                  <a class="hover:text-accent-700" href={`/weekenden/${weekend.slug}`}>
                    {weekend.name}
                  </a>
                </h4>
                <p class="text-base-700">{weekend.shortDescription}</p>
                <div class="mt-auto flex flex-wrap items-center justify-between gap-3 border-t border-base-200 pt-4 text-sm font-semibold">
                  <a class="text-accent-700 hover:underline" href={`/weekenden/${weekend.slug}`}>
                    Bekijk eerdere editie
                  </a>
                  <a
                    href={returningWeekendInterestLinks[weekend.slug]}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center rounded-full bg-accent-600 px-4 py-2.5 text-white transition hover:bg-accent-700"
                  >
                    Zet mij op de interesselijst
                  </a>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
    <a href="/reizen" class="hidden md:flex justify-end text-xs tracking-wide uppercase text-base-500 hover:text-accent-700">
      Meer reizen →
    </a>
    </div>
  </section>

  <style>
    .weekend-scroll-track {
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: calc((100% - 1.5rem) / 2);
      gap: 1.5rem;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      padding-bottom: 0.5rem;
      scrollbar-width: thin;
      scrollbar-color: rgba(53, 65, 46, 0.35) transparent;
    }

    .weekend-scroll-track > article {
      scroll-snap-align: start;
      min-width: 0;
    }

    @media (max-width: 1023px) {
      .weekend-scroll-track {
        grid-auto-columns: minmax(320px, 75%);
      }
    }

    @media (max-width: 767px) {
      .weekend-scroll-track {
        grid-auto-columns: minmax(260px, 90%);
      }
    }
  </style>

  <section class="order-1 max-w-6xl mx-auto my-8 rounded-3xl bg-white px-6 py-8 lg:my-14 lg:py-14 space-y-8 scroll-fade-in">
    <div class="flex flex-col lg:flex-row gap-12 items-center">
      <div class="flex-1 space-y-4 lg:pr-8">
        <p class="uppercase text-xs tracking-[0.25em] text-base-500">
          {homePage.sectionOverOns.label}
        </p>
        <h3 class="text-3xl font-semibold text-base-900">
          {homePage.sectionOverOns.title}
        </h3>
        <p class="text-base-700" set:html={linkedOverOnsDescription} />
        <a
          class="inline-flex items-center justify-center px-5 py-3 rounded-full border border-base-300 text-base-800 font-semibold hover:border-base-500 w-fit"
          href="/over-ons"
        >
          {homePage.sectionOverOns.cta}
        </a>
      </div>
      <div class="flex-1 lg:pl-8">
        <div class="skewed-image-frame">
          <img
            class="skewed-image-inner"
            src={optimizedHauteLoire.src}
            width={optimizedHauteLoire.width}
            height={optimizedHauteLoire.height}
            alt="SOLA reis in de natuur"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </section>
  </div>

  <section class="bg-accent-600 text-white py-10 lg:py-16 scroll-fade-in">
    <div class="max-w-4xl mx-auto px-6 text-center space-y-6">
      <h3 class="text-3xl font-semibold">{homeCopy.afsluiting.title}</h3>
      <div class="flex flex-wrap justify-center gap-3">
        <a
          class="px-5 py-3 rounded-full bg-base-25 text-base-900 font-semibold"
          href="/reizen/altijd-aan">Bekijk de volgende editie</a
        >
        <a
          class="px-5 py-3 rounded-full border border-white/40 text-white font-semibold"
